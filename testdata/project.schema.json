{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ladvoy.com/portrait-card/0.1.0-draft/project.schema.json",
  "title": "Portrait Card project file",
  "description": "One project = one JSON document. Conforming files satisfy the data rules D1-D7 of the Portrait Card Spec.",
  "type": "object",
  "required": ["spec", "spec_version", "project", "principals", "groups", "cards"],
  "additionalProperties": false,
  "properties": {
    "spec": { "const": "portrait-card" },
    "spec_version": { "type": "string" },
    "project": { "$ref": "#/$defs/projectInfo" },
    "principals": { "type": "array", "items": { "$ref": "#/$defs/principal" } },
    "groups": { "type": "array", "items": { "type": "string" } },
    "cards": { "type": "array", "items": { "$ref": "#/$defs/card" } },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "extensions": { "type": "object" },

    "projectInfo": {
      "type": "object",
      "required": ["slug", "name"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "roles": {
          "type": "object",
          "description": "Role name -> member principal slugs.",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "interpretation": {
          "type": "array",
          "items": { "$ref": "#/$defs/interpretationRule" }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },

    "principal": {
      "type": "object",
      "required": ["slug"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string" },
        "attributes": {
          "type": "object",
          "description": "Client-facing configuration (language, style), never facts about the person."
        },
        "card": { "type": "string", "description": "Slug of this principal's own card." },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },

    "card": {
      "type": "object",
      "required": ["slug", "type", "name", "facts"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string" },
        "type": { "type": "string", "description": "Open vocabulary: person, pet, place, organization, family, object, project, topic, ..." },
        "name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "visibility": { "$ref": "#/$defs/visibility" },
        "keys": { "type": "array", "items": { "type": "string" } },
        "time": { "$ref": "#/$defs/time" },
        "revalidate": { "$ref": "#/$defs/revalidate" },
        "interpretation": { "type": "array", "items": { "$ref": "#/$defs/interpretationRule" } },
        "disclosure": { "$ref": "#/$defs/disclosureRule" },
        "core": { "type": "array", "items": { "type": "string" } },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },

    "fact": {
      "type": "object",
      "required": ["id", "text", "source", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Unique in the project; f_ prefix conventional." },
        "text": { "type": "string", "minLength": 1, "description": "One thought, self-contained." },
        "author": { "type": "string", "description": "Principal slug; default per spec 2.3." },
        "status": { "enum": ["pending", "confirmed", "rejected"] },
        "source": { "$ref": "#/$defs/source" },
        "time": { "$ref": "#/$defs/time" },
        "revalidate": { "$ref": "#/$defs/revalidate" },
        "groups": { "type": "array", "items": { "type": "string" } },
        "visibility": { "$ref": "#/$defs/visibility" },
        "core": { "type": "array", "items": { "type": "string" } },
        "keys": { "type": "array", "items": { "type": "string" } },
        "interpretation": { "type": "array", "items": { "$ref": "#/$defs/interpretationRule" } },
        "disclosure": { "$ref": "#/$defs/disclosureRule" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },

    "source": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "description": "Open list: document, message, note, observation, interview, conversation." },
        "ref": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "note": { "type": "string" }
      }
    },

    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" }
      }
    },

    "revalidate": {
      "type": "string",
      "anyOf": [
        { "const": "never" },
        { "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$" }
      ]
    },

    "visibility": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "everyone" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "owner" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "role"],
          "properties": { "mode": { "const": "role" }, "role": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "principals"],
          "properties": {
            "mode": { "const": "list" },
            "principals": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          }
        }
      ]
    },

    "interpretationRule": {
      "type": "object",
      "required": ["when"],
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "object",
          "description": "Principal configuration match or {\"role\": name}."
        },
        "text": { "type": "string", "description": "Prepared presentation text." },
        "directive": { "type": "string", "description": "Instruction to the presenting system." }
      }
    },

    "disclosureRule": {
      "type": "object",
      "required": ["until", "then"],
      "additionalProperties": false,
      "properties": {
        "until": { "type": "string", "description": "Date or condition." },
        "then": { "$ref": "#/$defs/visibility" },
        "meanwhile": { "type": "string", "description": "Prepared answer while the rule is active; may reference {owner}." },
        "review": { "$ref": "#/$defs/revalidate" }
      }
    }
  }
}
