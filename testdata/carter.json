          "status": "confirmed",
          "source": { "type": "observation", "ref": "family life" },
          "groups": ["household"]
        },
        {
          "id": "f_persik_vacuum",
          "text": "Persik is afraid of the vacuum cleaner.",
          "status": "confirmed",
          "source": { "type": "observation", "ref": "family life" },
          "groups": ["household"]
        },
        {
          "id": "f_persik_health",
          "text": "Persik has no allergies.",
          "status": "confirmed",
