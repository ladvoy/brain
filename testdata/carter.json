    {
      "slug": "carter-family",
      "type": "family",
      "name": "The Carter family",
      "aliases": ["we", "our family", "the Carters"],
      "facts": [
        {
          "id": "f_family_home",
          "text": "The Carters live in a house with a garden at 12 Vyazovaya Street.",
          "status": "confirmed",
          "source": { "type": "interview", "ref": "onboarding 2026" },
          "groups": ["household"]
        },
        {
          "id": "f_family_renovation",
          "text": "The bathroom renovation is planned for spring — decided in the October chat and confirmed.",
          "status": "confirmed",
          "source": { "type": "message", "ref": "family chat 10.2026" },
          "time": { "from": "2026-10-01" },
          "groups": ["household"],
          "visibility": { "mode": "role", "role": "adults" },
          "revalidate": "P3M"
        },
        {
          "id": "f_family_reserve",
          "text": "The family is building a reserve of six months' worth of expenses — sixty percent is already put aside.",
          "status": "confirmed",
          "source": { "type": "message", "ref": "family chat 09.2026" },
          "time": { "from": "2026-09-01" },
          "groups": ["money"],
          "visibility": { "mode": "role", "role": "adults" },
          "revalidate": "P1M"
        },
        {
          "id": "f_family_budget",
          "text": "The gift budget is about five thousand per person.",
          "status": "confirmed",
          "source": { "type": "interview", "ref": "onboarding 2026" },
          "groups": ["money", "gifts"],
          "visibility": { "mode": "role", "role": "adults" },
          "interpretation": [
            {
              "when": { "role": "children" },
              "text": "There is a family gift limit — check with Mom whether your idea fits."
            }
          ],
          "core": ["gifts"],
          "revalidate": "P6M"
        },
        {
          "id": "f_family_friday",
          "text": "Friday family dinner is sacred — nobody is ever struck off it.",
          "status": "confirmed",
          "source": { "type": "observation", "ref": "family life" },
          "groups": ["traditions"],
          "core": ["traditions"]
        },
        {
          "id": "f_family_bday_menu",
          "text": "On a birthday, the birthday person chooses the menu themselves.",
          "status": "confirmed",
          "source": { "type": "observation", "ref": "family life" },
          "groups": ["traditions"]
        },
        {
          "id": "f_family_charter",
          "text": "The family agreement: private things are not read into and not retold; adults' secrets are never revealed to the children, and children's secrets are never revealed to the adults; important health matters reach the children gently and are never hidden when the child asks directly. Each family member is shown the agreement when they join.",
          "status": "confirmed",
          "source": { "type": "document", "ref": "family charter" },
          "groups": ["agreement"],
          "core": ["agreement"]
        },
        {
          "id": "f_family_safety",
          "text": "The single exception to the agreement: if someone speaks of suicide, self-harm, violence, a threat to life, or abuse, the agreement breaks — Rose and Jack are told at once, with the exact words.",
          "status": "confirmed",
          "source": { "type": "document", "ref": "family charter" },
          "groups": ["agreement"]
        }
      ],
      "extensions": {}
    }
  ],
  "extensions": {}
}
